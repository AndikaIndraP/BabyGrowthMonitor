# Salin menjadi .env. run.bat/bot.py mengisi TELEGRAM_BOT_TOKEN dan ALLOWED_USER_IDS otomatis.
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# Opsional (nilai di bawah = default)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_BASE=babygrowth/babygrowth123/device01
DB_PATH=babygrowth.db
DEVICE_OFFLINE_SECONDS=45
TZ_OFFSET_HOURS=7
